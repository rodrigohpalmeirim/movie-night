# Copy to .env and fill in. .env is git-ignored and must never be committed.

# TMDB API key (server-side only — never expose to the client).
# Used by the movie-search proxy and to fetch runtime at save time.
# Missing or empty → search and suggestion return 503 with a clear message.
TMDB_API_KEY=

# SQLite file. Point this at a persistent volume in production.
DATABASE_URL=./data/movie-voting.db

# ── Runtime (svelte-adapter-bun) ────────────────────────────────────────────
# HOST/PORT the Bun server binds to.
HOST=0.0.0.0
PORT=3000

# Public origin. REQUIRED unless a reverse proxy sets PROTOCOL_HEADER/HOST_HEADER:
# the adapter otherwise assumes https:// + the Host header, and SvelteKit's CSRF
# check then rejects every form POST with 403 "Cross-site POST form submissions
# are forbidden". HTTPS is mandatory in production anyway (the invite token
# travels in URLs).
ORIGIN=https://movie-night.example

# Idle connection timeout, in seconds. MUST exceed the SSE keep-alive interval or
# every browser tab's event stream dies and reconnects in a loop. The adapter
# defaults to 10s, which is why the keep-alive defaults to 8s; raise both together
# to reduce chatter.
IDLE_TIMEOUT=60
SSE_KEEPALIVE_MS=20000

# Behind nginx/Caddy instead, forward the real scheme and host and omit ORIGIN:
# PROTOCOL_HEADER=x-forwarded-proto
# HOST_HEADER=x-forwarded-host
# XFF_DEPTH=1
#
# ADDRESS_HEADER is NOT optional behind a proxy. Every request would otherwise
# arrive from the proxy's single IP, so both rate limiters (group creation, TMDB
# search/suggest) collapse into ONE GLOBAL BUCKET: one member typing in the search
# box locks out the whole group, and the group-creation limit becomes 5/hour for
# the entire server. Set it to the header your proxy actually sets, and make sure
# the proxy overwrites rather than appends it, or a client can forge the value.
# ADDRESS_HEADER=x-forwarded-for
#
# Also disable response buffering on the SSE route or the keep-alive pings never
# arrive: nginx honours the `X-Accel-Buffering: no` the route already sends.

# ── Developer tooling ───────────────────────────────────────────────────────
# DEV_MODE=1 turns on the member switcher: a slim amber bar above the tab bar
# listing the group's members, where tapping one re-points this browser's member
# cookie at that member (POST /g/<token>/dev/switch). One browser can then play
# all five members of a round.
#
# Only the exact string `1` enables it. With it unset the bar's markup is never
# rendered and the switch endpoint 404s, so there is zero behaviour change.
#
# NEVER set this in production: it makes assuming another member's identity a
# single tap for anyone holding the invite link.
# DEV_MODE=1
#
# The demo group the switcher is meant to be used with:
#   bun run seed        # "Movie Club" at /g/dev-movie-club — 5 members, 12 pool
#                       # movies, 2 watched nights, tonight's round open.
#                       # Re-running wipes and recreates only that group.
